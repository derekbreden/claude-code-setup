{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-memory-write.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-residue.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-underived-measurement.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-branch.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-flash-before-commit.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-web.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-effort-estimate.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-unexplained-hedge.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-question-as-disagreement.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-unlooked-move.sh",
            "timeout": 6
          }
        ]
      }
    ],
    "SubagentStop": [],
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/note-inherited-fence.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/note-pick-text.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/note-inherited-fence.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/reap-abandoned-forks.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
