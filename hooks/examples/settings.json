{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/deliver-relay-message.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/warn-elevation-write.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-branch.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-flash-before-commit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-no-ignore.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-publish-below-floor.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-task-sleep-poll.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-web.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-effort-estimate.sh",
            "timeout": 6
          },
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-unwatched-wait.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-unwatched-wait.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/note-pick-text.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/note-inherited-fence.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-residue.sh",
            "timeout": 70
          },
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/block-underived-measurement.sh",
            "timeout": 12
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/note-inherited-fence.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/claude-code-setup/hooks/reap-abandoned-forks.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
