<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.derekbredensteiner.transcript-offload</string>
  <key>ProgramArguments</key>
  <array><string>__PYTHON__</string><string>-u</string><string>__REPO__/offload/transcript_offload.py</string><string>--apply</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>__HOME__/.config/transcript-offload/offload.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/transcript-offload/offload.log</string>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
